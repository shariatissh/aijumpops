# ==============================================================================
# AiJumpOps - Universal JumpServer Bastion / PAM Configuration Template
# ==============================================================================
# Copy this file to `.env` (or run `./jmsctl init`) and fill in your JumpServer
# credentials. Keep permissions restricted (`chmod 600 .env`).
# ==============================================================================

# 1. JumpServer Web / API URL (HTTPS or HTTP)
JMS_URL="https://jumpserver.example.com"

# 2. Primary Authentication: Username & Password + TOTP (2FA/MFA)
JMS_USERNAME="your_username"
JMS_PASSWORD="YOUR_PASSWORD_HERE"

# Optional: Base32 TOTP Secret (from Google Authenticator QR setup)
# If set, `./jmsctl` generates the 6-digit MFA code automatically without prompting!
# If left empty and MFA is enabled on your account, `./jmsctl` will prompt you for
# the 6-digit code via `./jmsctl auth-otp --code 123456` and cache the session.
JMS_TOTP_SECRET=""

# 3. Optional Alternative Authentication: Access Key / API Token
# (Only used if you prefer static API keys over Username/Password)
JMS_ACCESS_KEY_ID=""
JMS_ACCESS_KEY_SECRET=""
JMS_PRIVATE_TOKEN=""

# 4. Organization Scope (Default Organization UUID is auto-selected if empty)
# Default Org in JumpServer is usually "00000000-0000-0000-0000-000000000002"
JMS_ORG_ID=""

# 5. Connection & Security Options
JMS_VERIFY_SSL="true"
JMS_TIMEOUT="30"
JMS_PROXY=""
# Set to "auto", "v4", "v3", or "v2" (auto-detected by default)
JMS_API_VERSION="auto"
